# ============================================
# Nimbus Environment Configuration
# ============================================
# This file is OPTIONAL - Nimbus works out of the box with defaults!
# Only create a .env file if you want to customize settings.

# ============================================
# SECURITY (Recommended for production)
# ============================================

# Database password
# Default: nimbus-default-password (fine for local/homelab use)
# Special characters are fully supported (automatically URL-encoded)
# Generate with: openssl rand -base64 32
# DB_PASSWORD=your-secure-database-password

# JWT secret for authentication (minimum 32 characters)
# Default: Auto-generated and persisted in uploads volume
# Generate with: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32
# JWT_SECRET=your-super-secret-jwt-key

# ============================================
# NETWORK CONFIGURATION (Separate containers only)
# ============================================

# Frontend API URL - only needed for docker-compose.deprecated.yml
# The unified image (turboot/nimbus) handles this automatically.
#
# NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8080

# ============================================
# OPTIONAL - Defaults are applied if not set
# ============================================

# Database Configuration
# DB_HOST=db                   # Default: db (Docker service name)
# DB_PORT=5432                 # Default: 5432
# DB_NAME=nimbus               # Default: nimbus
# DB_USER=nimbus               # Default: nimbus

# Server Configuration
# PORT=8080                    # Default: 8080

# CORS Configuration
# CORS_ORIGINS=http://localhost:3000  # Default: http://localhost:3000

# Authentication
# JWT_EXPIRY=24h               # Default: 24h (handled in code)
# BCRYPT_COST=10               # Default: 10 (handled in code)

# Health Checks
# HEALTH_CHECK_INTERVAL=60    # Default: 60 seconds
# HEALTH_CHECK_TIMEOUT=10     # Default: 10 seconds

# Metrics
# METRICS_RETENTION_DAYS=30   # Default: 30 days

# ============================================
# OPTIONAL FEATURES
# ============================================

# Public URL of your Nimbus instance (used for password reset email links and OAuth redirects)
# Set this to the URL users access Nimbus at (e.g., https://nimbus.yourdomain.com)
# Default: http://localhost:3000
# FRONTEND_URL=https://nimbus.yourdomain.com

# OAuth Configuration (leave empty to disable)
# OAUTH_STATE_SECRET=          # Falls back to JWT_SECRET if not set

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback

# Discord OAuth
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/discord/callback

# SMTP Configuration (for password reset emails)
# Can also be configured via Admin Settings UI
# Note: SMTP credentials set via the Admin UI are stored unencrypted in the database.
# For production, prefer setting credentials here as env vars.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=Nimbus

# Prometheus Integration
# Generate API key with: openssl rand -hex 32
# PROMETHEUS_API_KEY=

# Auto-fetch icon: base URL for the homarr-labs/dashboard-icons curated SVG
# library. Defaults to jsDelivr. Override to point at a self-hosted mirror, an
# airgapped copy, or set to empty to disable curated lookup (origin scraping
# still works).
# DASHBOARD_ICONS_BASE_URL=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg

# Nimbus Cloud branding (set by Nimbus Cloud hosting)
# NEXT_PUBLIC_NIMBUS_CLOUD=true

# Disable public registration (for managed/cloud deployments)
# DISABLE_PUBLIC_REGISTRATION=true

# Auto-create admin on first boot (for automated/cloud deployments)
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=your-secure-password

# ============================================
# PRODUCTION SETTINGS
# ============================================

# Cookie Security (set to true for HTTPS)
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# Custom domain example:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# NEXT_PUBLIC_API_URL=https://yourdomain.com (see NETWORK CONFIGURATION section above)

# SEO Configuration (optional - for public instances)
# Set this to enable proper sitemap, robots.txt, and social sharing metadata
# NEXT_PUBLIC_SITE_URL=https://nimbus.yourdomain.com
